// Profile node `sheen_bsdf` -- NSI shading profile v1.
//
// OSL 1.12 reference implementation (requirement R5).
//
// Emits the profile `sheen` closure. Intended to be layered over a diffuse
// or dielectric base with `add_bsdf`.

shader nsi_sheen_bsdf
    [[ string help = "Microflake sheen for fabric-like rim scattering." ]]
(
    color base_color = color(1.0)
        [[ string help = "Sheen albedo, [0, 1] per channel." ]],
    float roughness = 0.3
        [[ string help = "Rim width, [0, 1]." ]],
    normal shading_normal = N
        [[ string help = "Shading normal; defaults to N." ]],
    output closure color out_bsdf = 0
)
{
    out_bsdf = sheen_bsdf(normalize(shading_normal),
                          clamp(base_color, color(0.0), color(1.0)),
                          clamp(roughness, 0.0, 1.0));
}
