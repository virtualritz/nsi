2026-06-16T15:23:03Z python3 - <<'PY'
import json,base64,re
data=json.load(open("/home/ritz/.config/3Delight.prefs"))
cl=data.get("cloud",{})
print("cloud block keys:", list(cl.keys()))
def seg(tok,i):
    p=tok.split('.')[i]; p+='='*(-len(p)%4)
    return json.loads(base64.urlsafe_b64decode(p))
jwt=cl.get("jwt","")
print("jwt segments:", len(jwt.split('.')), "(3 = standard JWT)")
print("refresh_token segments:", len(cl.get("refresh_token","").split('.')), "(5 = JWE / encrypted)")
try:
    hdr=seg(jwt,0); pl=seg(jwt,1)
    print("\n-- JWT header --", {k:hdr[k] for k in hdr if k in ('alg','kid','typ')})
    # only NON-secret integration config + non-PII
    safe={k:pl[k] for k in pl if k in ('iss','client_id','aud','token_use','scope','auth_time','exp','iat')}
    iss=pl.get('iss','')
    m=re.search(r'cognito-idp\.([a-z0-9-]+)\.amazonaws\.com/([\w-]+)',iss)
    print("-- JWT claims (config only) --")
    print("   iss        :", iss)
    if m: print("   region     :", m.group(1)); print("   userPoolId :", m.group(2))
    print("   client_id  :", pl.get('client_id') or pl.get('aud'))
    print("   token_use  :", pl.get('token_use'))
    print("   PII present in token (sub/email/etc): ", [k for k in pl if k in ('sub','email','cognito:username','custom:account')])
except Exception as e:
    print("decode note:", e)
PY
